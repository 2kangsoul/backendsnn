generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model User {
  id            String         @id @default(uuid())
  email         String         @unique @db.VarChar(150)
  username      String         @unique @db.VarChar(25)
  password      String
  fullName      String         @db.VarChar(50)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  address       String?
  adminDuration String?
  no_handphone  String        @unique @db.VarChar(20)
  profilePic    String?
  role          String         @default("user")
  country       String?        @db.VarChar(100)
  device        String?        @db.VarChar(50)
  expenses      Expense[]
  orders        Order[]
  perfumeLikes  PerfumeLike[]
  siteAnalytics SiteAnalytic[]
  subscriptions Subscription[]
  blogs         Blog[]         @relation("BlogToUser")
  products      Product[]      @relation("ProductToUser")

  @@map("users")
}

model Product {
  id          String      @id @default(uuid())

  name        String      @db.VarChar(250)
  brand       String      @db.VarChar(150)
  type        String?     @db.VarChar(100)
  description String?

  notes       String?

  price       Float
  stock       Int

  imageUrl    String?

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  orderItems  OrderItem[]
  users       User[]      @relation("ProductToUser")

  @@map("products")
}
model Blog {
  id          String    @id @default(uuid())
  title       String    @db.VarChar(250)
  content     String
  excerpt     String
  category    String?   @db.VarChar(150)
  author      String?   @db.VarChar(150)
  approval    Boolean?  @default(false)
  likes       Int?      @default(0)
  imageUrl    String?
  imageUrl2   String?
  imageUrl3   String?
  publishDate DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?
  users       User[]    @relation("BlogToUser")

  @@map("blogs")
}

model Order {
  id           String      @id @default(uuid())
  orderNumber  String      @unique @db.VarChar(50)

  totalAmount  Float
  status       OrderStatus @default(PENDING)
  userId       String
  note         String?     @db.VarChar(500)
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  deletedAt    DateTime?
  user         User        @relation(fields: [userId], references: [id])
  items        OrderItem[]
  @@map("orders")
}

model OrderItem {
  id        String   @id @default(uuid())
  quantity  Int
  price     Float
  orderId   String
  productId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  deletedAt DateTime?
  order      Order   @relation(fields: [orderId], references: [id])
  product    Product @relation(fields: [productId], references: [id])
  @@map("order_items")
}

model Subscription {
  id        String    @id @default(uuid())
  plan      String    @db.VarChar(100)
  status    String    @default("Active") @db.VarChar(50)
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  expiredAt DateTime?
  user      User      @relation(fields: [userId], references: [id])

  @@map("subscriptions")
}

model Expense {
  id          String   @id @default(uuid())
  amount      Float
  description String?  @db.VarChar(250)
  createdAt   DateTime @default(now())
  userId      String
  user        User     @relation(fields: [userId], references: [id])

  @@map("expenses")
}

model SiteAnalytic {
  id         String   @id @default(uuid())
  sessionId  String   @db.VarChar(150)
  deviceType String   @db.VarChar(50)
  country    String?  @db.VarChar(100)
  pageUrl    String?  @db.VarChar(250)
  createdAt  DateTime @default(now())
  userId     String?
  user       User?    @relation(fields: [userId], references: [id])

  @@index([createdAt])
  @@index([deviceType])
  @@index([country])
  @@map("site_analytics")
}

model Perfume {
  id          String        @id @default(uuid())
  name        String        @db.VarChar(250)
  brand       String        @db.VarChar(250)
  category    String        @db.VarChar(100)
  description String?
  imageUrl    String?
  gender      String?       @db.VarChar(50)
  year        Int?
  totalLikes  Int           @default(0)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  deletedAt   DateTime?
  notes       String?
  likes       PerfumeLike[]

  @@index([category])
  @@index([totalLikes])
  @@map("perfumes")
}

model PerfumeLike {
  id        String   @id @default(uuid())
  perfumeId String
  userId    String
  createdAt DateTime @default(now())
  perfume   Perfume  @relation(fields: [perfumeId], references: [id])
  user      User     @relation(fields: [userId], references: [id])

  @@unique([perfumeId, userId])
  @@map("perfume_likes")
}

enum Category {
  LIFESTYLE
  POLITIC
  SPORT
  FASHION
  RELIGIOUS
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum OrderStatus {
  PENDING
  PROCESSING
  DELIVERED
  PAID
  REJECTED
  REFUNDED
}